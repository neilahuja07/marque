# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is gitignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL (used for auth redirects) ---
# http://localhost:3000 for local dev; your Vercel URL in production
NEXT_PUBLIC_SITE_URL=

# --- Razorpay ---
# Key ID is safe to expose to the browser (NEXT_PUBLIC_ prefix).
# Key SECRET must NEVER be used in client-side code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=